digraph InboundFlow {
    graph [rankdir=TB, fontname="WenQuanYi Micro Hei", bgcolor="white",
           labelloc="t", fontsize=26, fontcolor="#1a1a1a",
           label="入库单创建流程图", nodesep=0.4, ranksep=0.5];
    node  [fontname="WenQuanYi Micro Hei", fontsize=14, style="filled,rounded", shape=box, penwidth=1.4];
    edge  [fontname="WenQuanYi Micro Hei", fontsize=12, color="#555555", penwidth=1.3];

    // ---------- 起止 ----------
    start [label="开始", shape=oval, style="filled", fillcolor="#4CAF50", fontcolor="white", width=1.2];
    end   [label="结束", shape=oval, style="filled", fillcolor="#F44336", fontcolor="white", width=1.2];

    // ---------- 角色配色：用户=橙 / 系统=绿 / 数据库=蓝 ----------
    // 用户操作
    u1 [label="点击“新增”按钮",           fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];
    u2 [label="选择业务类型",              fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];
    u3 [label="选择仓库",                  fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];
    u4 [label="选择供应商（采购 / 退货）",  fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];
    u5 [label="点击“添加物资”",           fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];
    u6 [label="选择物资、录入数量",         fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];
    u7 [label="填写备注",                  fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];
    u8 [label="点击“保存”",               fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100"];

    // 系统响应
    s1 [label="显示入库单新增页面",                     fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20"];
    s2 [label="根据业务类型动态显示\n供应商 / 调拨仓库等字段", fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20"];
    s5 [label="显示物资选择弹窗",                       fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20"];
    s6 [label="自动计算金额",                          fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20"];
    s8 [label="验证必填字段",                          fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20"];
    ssave [label="保存入库单到数据库",                  fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20"];
    sok [label="返回保存成功提示",                      fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20"];

    // 数据库
    d1 [label="生成入库单号",     fillcolor="#B3E5FC", color="#0288D1", fontcolor="#01579B"];
    d2 [label="持久化保存入库单",  fillcolor="#B3E5FC", color="#0288D1", fontcolor="#01579B"];

    // ---------- 主流程 ----------
    start -> u1 -> s1 -> u2 -> s2 -> u3 -> u4 -> u5 -> s5 -> u6 -> s6 -> u7 -> u8 -> s8 -> d1 -> ssave -> d2 -> sok -> end;

    // ---------- 图例 ----------
    subgraph cluster_legend {
        label="图例（按角色着色）"; fontsize=15; fontcolor="#37474F";
        style="filled,rounded"; fillcolor="#FAFAFA"; color="#B0BEC5"; penwidth=1.4;
        legend_u [label="用户操作", fillcolor="#FFE0B2", color="#F57C00", fontcolor="#E65100", width=1.6];
        legend_s [label="系统响应", fillcolor="#C8E6C9", color="#388E3C", fontcolor="#1B5E20", width=1.6];
        legend_d [label="数据库",   fillcolor="#B3E5FC", color="#0288D1", fontcolor="#01579B", width=1.6];
        legend_u -> legend_s -> legend_d [style=invis];
    }
}
